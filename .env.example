# ============================================================================
# QR Attendance System - Environment Configuration (.env)
# ============================================================================

# Database (Prisma + SQLite, local zero-cost file storage)
DATABASE_URL="file:./dev.db"

# NextAuth v5 Secret & Host Settings
AUTH_SECRET="attendly-app-secure-default-encryption-secret-32-bytes"
NEXTAUTH_SECRET="attendly-app-secure-default-encryption-secret-32-bytes"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Public Access URL (Base URL embedded into QR codes)
# Leave as http://localhost:3000 or set to your Wi-Fi LAN IP (e.g. http://192.168.1.50:3000)
# When running with `start.bat`, the Cloudflare Quick Tunnel URL (*.trycloudflare.com)
# is automatically detected and prioritized for phone QR scans.
APP_URL="http://localhost:3000"

# Email Configuration (Optional)
# If left blank, the system operates in zero-config dev mode (tokens displayed directly in UI).
# Fill in standard SMTP credentials for production email delivery if needed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@university.edu"
DEV_MODE_EMAIL="1"
