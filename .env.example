# Copy this file to `.env` and fill in real values.
#   cp .env.example .env

# ----- Prisma / SQLite (free, file-based, no setup) ----------------------------
DATABASE_URL="file:./dev.db"

# ----- NextAuth v5 (random 32+ char string) -------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-with-a-random-32+char-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ----- Public URL ---------------------------------------------------------------
# THIS IS THE URL YOUR STUDENTS' PHONES WILL HIT WHEN THEY SCAN A QR.
# It is the canonical "phone-reachable" base URL baked into every QR code.
# Set it to your machine's IPv4 on the same Wi-Fi your students will use
# (e.g. http://192.168.10.206:3000). If you only ever test from the same
# machine, leave it as-is — phones cannot reach localhost.
#
# Find your IPv4:
#   Windows:  ipconfig
#   macOS:    ifconfig | grep "inet "
#   Linux:    ip -4 addr
#
# Both the server and your phone MUST be on the same Wi-Fi network.
APP_URL="http://192.168.10.206:3000"

# ----- Setup key for /api/auth/register (currently UNUSED) ---------------------
# Registration is OPEN by default — anyone with the /register link can create a
# professor account. If you want to gate this in the future, add the check back
# in src/app/api/auth/register/route.ts and set this env var.
# SETUP_KEY="generate-with-crypto-randomBytes-16-base64url"

# ----- Email (optional) ---------------------------------------------------------
# Leave all SMTP_* empty to use "dev mode" — the verification link is then
# surfaced inline in the browser, so the app works 100% free with no external
# services. As soon as you fill SMTP_HOST/USER/PASS, real email is used.
#
# Free SMTP options when you're ready:
#   - Resend      : https://resend.com  (3,000/month free)
#   - Brevo       : https://www.brevo.com (300/day free)
#   - Mailgun     : https://www.mailgun.com (100/day free, sandbox domain)
#   - Gmail relay : app password + smtp.gmail.com
#
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@university.edu"

# Force dev-mode email regardless of SMTP config. Set to "0" in production.
DEV_MODE_EMAIL="1"
