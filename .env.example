# ==============================================================================
# Attendly — Environment Configuration Template (.env.example)
# Copy this file to .env and configure for your network environment
# ==============================================================================

# Reverse Proxy Listening Port (Default: 80 for standard HTTP, or 8080 if 80 is occupied)
PROXY_PORT=80

# NextAuth Encryption Secret (Required: 32+ character random string)
# Auto-generated by the installer on first run
NEXTAUTH_SECRET=replace-with-a-secure-random-32-byte-hex-secret

# Application Base URL (Used for authentication callbacks and session cookies)
# Set to your computer's local Wi-Fi IP (e.g. http://192.168.1.150) or domain
NEXTAUTH_URL=http://localhost

# Public Access URL (Embedded into student QR codes for mobile attendance)
# Set to http://<YOUR_LAN_IP>:<PROXY_PORT> or your Cloudflare Tunnel URL
APP_URL=http://localhost

# Database Connection (SQLite file inside persistent Docker volume)
DATABASE_URL=file:./dev.db

# Optional SMTP Email Configuration (Leave blank for zero-config local display mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@university.edu
DEV_MODE_EMAIL=1
