{
  "name": "attendly",
  "version": "1.0.1",
  "description": "Self-hosted academic attendance management with QR check-ins, course rosters, and Excel reports.",
  "license": "MIT",
  "author": "Attendly Open Source Community",
  "homepage": "https://github.com/Gheorghe-dev/Attendly",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gheorghe-dev/Attendly.git"
  },
  "keywords": [
    "attendance",
    "education",
    "higher-education",
    "university",
    "qr-code",
    "nextjs",
    "electron",
    "anti-proxy",
    "classroom"
  ],
  "main": "electron/main.js",
  "scripts": {
    "launch": "node scripts/start-internet.js",
    "start:all": "node scripts/start-internet.js",
    "app": "node scripts/start-internet.js",
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "tunnel": "npx --yes localtunnel --port 3000",
    "desktop": "electron .",
    "desktop:start": "npm run desktop:package && electron .",
    "desktop:package": "npm run build && node scripts/prepare-standalone.js",
    "desktop:build": "npm run desktop:package && electron-builder --win",
    "desktop:build:win": "npm run desktop:package && electron-builder --win",
    "desktop:build:mac": "npm run desktop:package && electron-builder --mac",
    "desktop:build:linux": "npm run desktop:package && electron-builder --linux",
    "desktop:build:all": "npm run desktop:package && electron-builder -mwl",
    "desktop:pack": "npm run desktop:package && electron-builder --dir",
    "installer:win": "npm run desktop:build:win",
    "installer:mac": "npm run desktop:build:mac",
    "installer:all": "npm run desktop:build:all",
    "lint": "next lint",
    "test": "jest --passWithNoTests",
    "test:e2e": "tsx scripts/verify-all.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:excel": "tsx seed/create-sample-excel.ts",
    "db:demo": "tsx seed/create-demo-excel.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "docs:pdf": "node scripts/generate-pdf.js",
    "shortcuts": "node scripts/create-shortcuts.js"
  },
  "build": {
    "appId": "org.attendly.desktop",
    "productName": "Attendly",
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.js",
    "extraMetadata": {
      "dependencies": {}
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/prisma/**",
      "node_modules/@prisma/engines/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "attendly.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "pkg",
        "zip"
      ],
      "icon": "public/emblem.png",
      "category": "public.app-category.education"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "pkg": {
      "installLocation": "/Applications",
      "allowCurrentUserHome": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png",
      "category": "Education"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "shortcutName": "Attendly",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "attendly.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "node_modules/**"
        ]
      },
      {
        "from": "prisma",
        "to": "prisma"
      },
      {
        "from": "bin",
        "to": "bin"
      }
    ]
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/leaflet": "^1.9.22",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.60.0",
    "next": "14.2.35",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-day-picker": "^10.0.2",
    "react-dom": "^18",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "electron": "^44.9.1",
    "electron-builder": "^26.18.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
